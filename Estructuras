1- Definir una estructura de datos que contenga el nombre de un alumno, edad y año al que pertenece. Luego, que el código imprima esos datos. 

- Hacer que el usuario pueda modificar esos datos y luego que imprima esos datos modificados por el usuario. 

#include <stdio.h>

struct Alumno {
    char nombre[50];
    int edad;
    int anio;
};

void imprimirAlumno(struct Alumno a) {
    printf("Nombre: %s\n", a.nombre);
    printf("Edad: %d\n", a.edad);
    printf("Anio: %d\n", a.anio);
}

int main() {
    struct Alumno alumno = {"Juan Perez", 15, 3};

    printf("Datos del alumno:\n");
    imprimirAlumno(alumno);

    printf("\nIngrese los nuevos datos:\n");
    printf("Nombre: ");
    scanf(" %49[^\n]", alumno.nombre);
    printf("Edad: ");
    scanf("%d", &alumno.edad);
    printf("Anio: ");
    scanf("%d", &alumno.anio);

    printf("\nDatos modificados:\n");
    imprimirAlumno(alumno);

    return 0;
}
2- Al código anterior, utilizar un ciclo for para que se modifiquen esos datos en 3 estructuras de datos diferentes.
#include <stdio.h>

#define CANT 3

struct Alumno {
    char nombre[50];
    int edad;
    int anio;
};

void imprimirAlumno(struct Alumno a) {
    printf("Nombre: %s\n", a.nombre);
    printf("Edad: %d\n", a.edad);
    printf("Anio: %d\n", a.anio);
}

int main() {
    struct Alumno alumnos[CANT] = {
        {"Juan Perez", 15, 3},
        {"Ana Gomez", 14, 2},
        {"Luis Diaz", 16, 4}
    };
    int i;

    printf("Datos originales:\n");
    for (i = 0; i < CANT; i++) {
        printf("\n--- Alumno %d ---\n", i + 1);
        imprimirAlumno(alumnos[i]);
    }

    for (i = 0; i < CANT; i++) {
        printf("\nIngrese los nuevos datos del alumno %d:\n", i + 1);
        printf("Nombre: ");
        scanf(" %49[^\n]", alumnos[i].nombre);
        printf("Edad: ");
        scanf("%d", &alumnos[i].edad);
        printf("Anio: ");
        scanf("%d", &alumnos[i].anio);
    }

    printf("\nDatos modificados:\n");
    for (i = 0; i < CANT; i++) {
        printf("\n--- Alumno %d ---\n", i + 1);
        imprimirAlumno(alumnos[i]);
    }

    return 0;
}
DESAFÍO PEDRO OLIVA: (ESTRUCTURAS) 

Genere una estructura de tipo “Paciente” utilizando typedef que contenga: 

Edad 

Iniciales 

Tipo de sangre 

Altura 

Luego, que el usuario indique estos valores y pueda imprimir cualquiera de ellos cuantas veces desee. 
#include <stdio.h>

typedef struct {
    int edad;
    char iniciales[4];
    char tipoSangre[4];
    float altura;
} Paciente;

int main() {
    Paciente p;
    int opcion;

    printf("Ingrese los datos del paciente:\n");
    printf("Edad: ");
    scanf("%d", &p.edad);
    printf("Iniciales (ej: JP): ");
    scanf(" %3s", p.iniciales);
    printf("Tipo de sangre (ej: A+, O-): ");
    scanf(" %3s", p.tipoSangre);
    printf("Altura en metros (ej: 1.75): ");
    scanf("%f", &p.altura);

    do {
        printf("\n===== MENU =====\n");
        printf("1. Ver edad\n");
        printf("2. Ver iniciales\n");
        printf("3. Ver tipo de sangre\n");
        printf("4. Ver altura\n");
        printf("5. Ver todos los datos\n");
        printf("6. Salir\n");
        printf("Elija una opcion: ");
        scanf("%d", &opcion);

        switch (opcion) {
            case 1:
                printf("Edad: %d anios\n", p.edad);
                break;
            case 2:
                printf("Iniciales: %s\n", p.iniciales);
                break;
            case 3:
                printf("Tipo de sangre: %s\n", p.tipoSangre);
                break;
            case 4:
                printf("Altura: %.2f m\n", p.altura);
                break;
            case 5:
                printf("Edad: %d anios\n", p.edad);
                printf("Iniciales: %s\n", p.iniciales);
                printf("Tipo de sangre: %s\n", p.tipoSangre);
                printf("Altura: %.2f m\n", p.altura);
                break;
            case 6:
                printf("Programa finalizado.\n");
                break;
            default:
                printf("Opcion invalida.\n");
        }
    } while (opcion != 6);

    return 0;
}
