DESAFÍO PEDRO OLIVA: (ESTRUCTURAS) 

Genere una estructura de tipo “Paciente” utilizando typedef que contenga:

Edad

Iniciales

Tipo de sangre

Altura

Luego, que el usuario indique estos valores y pueda imprimir cualquiera de ellos cuantas veces desee.
#include <stdio.h>

typedef struct {
    int edad;
    char iniciales[4];
    char tipoSangre[4];
    float altura;
} Paciente;

int main() {
    Paciente p;
    int opcion;

    printf("Ingrese los datos del paciente:\n");
    printf("Edad: ");
    scanf("%d", &p.edad);
    printf("Iniciales (ej: JP): ");
    scanf(" %3s", p.iniciales);
    printf("Tipo de sangre (ej: A+, O-): ");
    scanf(" %3s", p.tipoSangre);
    printf("Altura en metros (ej: 1.75): ");
    scanf("%f", &p.altura);

    do {
        printf("\n===== MENU =====\n");
        printf("1. Ver edad\n");
        printf("2. Ver iniciales\n");
        printf("3. Ver tipo de sangre\n");
        printf("4. Ver altura\n");
        printf("5. Ver todos los datos\n");
        printf("6. Salir\n");
        printf("Elija una opcion: ");
        scanf("%d", &opcion);

        switch (opcion) {
            case 1:
                printf("Edad: %d anios\n", p.edad);
                break;
            case 2:
                printf("Iniciales: %s\n", p.iniciales);
                break;
            case 3:
                printf("Tipo de sangre: %s\n", p.tipoSangre);
                break;
            case 4:
                printf("Altura: %.2f m\n", p.altura);
                break;
            case 5:
                printf("Edad: %d anios\n", p.edad);
                printf("Iniciales: %s\n", p.iniciales);
                printf("Tipo de sangre: %s\n", p.tipoSangre);
                printf("Altura: %.2f m\n", p.altura);
                break;
            case 6:
                printf("Programa finalizado.\n");
                break;
            default:
                printf("Opcion invalida.\n");
        }
    } while (opcion != 6);

    return 0;
}
