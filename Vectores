1- Crear un código en C que le permita al usuario modificar los datos de un vector y luego que el programa imprima los datos 1 por 1.
#include <stdio.h>

#define N 5

int main() {
    int vector[N] = {10, 20, 30, 40, 50};
    int i;

    printf("Vector original:\n");
    for (i = 0; i < N; i++) {
        printf("Posicion %d: %d\n", i, vector[i]);
    }

    printf("\nIngrese los nuevos datos del vector:\n");
    for (i = 0; i < N; i++) {
        printf("Dato [%d]: ", i);
        scanf("%d", &vector[i]);
    }

    printf("\nDatos del vector, uno por uno:\n");
    for (i = 0; i < N; i++) {
        printf("Posicion %d: %d\n", i, vector[i]);
    }

    return 0;
}
2- Crear un código que una vez indicados los datos que almacena un vector, sume todos sus datos y los imprima. 

-Una vez realizado, calcule el promedio de esos datos. 
#include <stdio.h>

#define N 5

int main() {
    int vector[N];
    int i, suma = 0;
    float promedio;

    for (i = 0; i < N; i++) {
        printf("Ingrese el dato [%d]: ", i);
        scanf("%d", &vector[i]);
    }

    for (i = 0; i < N; i++) {
        suma += vector[i];
    }
    printf("\nLa suma de los datos es: %d\n", suma);

    promedio = (float)suma / N;
    printf("El promedio de los datos es: %.2f\n", promedio);

    return 0;
}
3- Crear un código que una vez que el usuario le ingrese los datos a un vector, pueda elegir puntualmente a cuál dato quiere acceder. 

-Una vez realizado, haga que el usuario indique cuando termina el código.
#include <stdio.h>

#define N 5

int main() {
    int vector[N];
    int i, pos;
    char continuar;

    for (i = 0; i < N; i++) {
        printf("Ingrese el dato [%d]: ", i);
        scanf("%d", &vector[i]);
    }

    do {
        printf("\nQue posicion desea consultar (0 a %d)? ", N - 1);
        scanf("%d", &pos);

        if (pos >= 0 && pos < N) {
            printf("El dato en la posicion %d es: %d\n", pos, vector[pos]);
        } else {
            printf("Posicion invalida.\n");
        }

        printf("Desea consultar otro dato? (s/n): ");
        scanf(" %c", &continuar);
    } while (continuar == 's' || continuar == 'S');

    printf("\nPrograma finalizado.\n");
    return 0;
}
4- Realice un código que permita comparar los valores de 2 vectores, indicar cuál valor es el mayor y a qué vector corresponde. 

- Una vez realizado, haga que la comparación se realice a través de una función aparte del main. 
#include <stdio.h>

#define N 5

void comparar(int a[], int b[], int n) {
    int i;
    for (i = 0; i < n; i++) {
        if (a[i] > b[i]) {
            printf("Posicion %d: el mayor es %d (Vector A)\n", i, a[i]);
        } else if (b[i] > a[i]) {
            printf("Posicion %d: el mayor es %d (Vector B)\n", i, b[i]);
        } else {
            printf("Posicion %d: ambos valores son iguales (%d)\n", i, a[i]);
        }
    }
}

int main() {
    int a[N], b[N];
    int i;

    printf("Datos del Vector A:\n");
    for (i = 0; i < N; i++) {
        printf("A[%d]: ", i);
        scanf("%d", &a[i]);
    }

    printf("\nDatos del Vector B:\n");
    for (i = 0; i < N; i++) {
        printf("B[%d]: ", i);
        scanf("%d", &b[i]);
    }

    printf("\nComparacion:\n");
    comparar(a, b, N);

    return 0;
}
5- Realizar un programa que ordene de mayor a menor los valores adentro de un vector de tamaño 10. A través de una función que sume esos valores y realice el promedio. 
#include <stdio.h>

#define N 10

void sumaYPromedio(int v[], int n) {
    int i, suma = 0;
    for (i = 0; i < n; i++) {
        suma += v[i];
    }
    printf("\nSuma de los valores: %d\n", suma);
    printf("Promedio: %.2f\n", (float)suma / n);
}

int main() {
    int v[N];
    int i, j, aux;

    for (i = 0; i < N; i++) {
        printf("Ingrese el dato [%d]: ", i);
        scanf("%d", &v[i]);
    }

    /* Ordenamiento burbuja de mayor a menor */
    for (i = 0; i < N - 1; i++) {
        for (j = 0; j < N - 1 - i; j++) {
            if (v[j] < v[j + 1]) {
                aux = v[j];
                v[j] = v[j + 1];
                v[j + 1] = aux;
            }
        }
    }

    printf("\nVector ordenado de mayor a menor:\n");
    for (i = 0; i < N; i++) {
        printf("%d ", v[i]);
    }
    printf("\n");

    sumaYPromedio(v, N);

    return 0;
}
DESAFÍO PEDRO OLIVA: (VECTORES) 
Realizar un código que le permita al usuario ingresar valores en un vector de tamaño 5, luego, que el usuario pueda acceder a cada uno de esos valores, modificarlos e imprimirlos tantas veces quiera.
#include <stdio.h>

#define N 5

void imprimirVector(int v[], int n) {
    int i;
    printf("\nContenido del vector:\n");
    for (i = 0; i < n; i++) {
        printf("Posicion %d: %d\n", i, v[i]);
    }
}

int main() {
    int vector[N];
    int i, pos, opcion;

    printf("Ingrese los %d valores del vector:\n", N);
    for (i = 0; i < N; i++) {
        printf("Valor [%d]: ", i);
        scanf("%d", &vector[i]);
    }

    do {
        printf("\n===== MENU =====\n");
        printf("1. Ver un valor\n");
        printf("2. Modificar un valor\n");
        printf("3. Imprimir todo el vector\n");
        printf("4. Salir\n");
        printf("Elija una opcion: ");
        scanf("%d", &opcion);

        switch (opcion) {
            case 1:
                printf("Posicion a consultar (0 a %d): ", N - 1);
                scanf("%d", &pos);
                if (pos >= 0 && pos < N) {
                    printf("El valor en la posicion %d es: %d\n", pos, vector[pos]);
                } else {
                    printf("Posicion invalida.\n");
                }
                break;

            case 2:
                printf("Posicion a modificar (0 a %d): ", N - 1);
                scanf("%d", &pos);
                if (pos >= 0 && pos < N) {
                    printf("Valor actual: %d\n", vector[pos]);
                    printf("Nuevo valor: ");
                    scanf("%d", &vector[pos]);
                    printf("Valor modificado correctamente.\n");
                } else {
                    printf("Posicion invalida.\n");
                }
                break;

            case 3:
                imprimirVector(vector, N);
                break;

            case 4:
                printf("Programa finalizado.\n");
                break;

            default:
                printf("Opcion invalida.\n");
        }
    } while (opcion != 4);

    return 0;
}
