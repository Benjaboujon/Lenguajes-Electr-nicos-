3- Crear un código que una vez que el usuario le ingrese los datos a un vector, pueda elegir puntualmente a cuál dato quiere acceder.
-Una vez realizado, haga que el usuario indique cuando termina el código.
#include <stdio.h>
#define N 5
int main() {
int vector[N];
int i, pos;
char continuar;
for (i = 0; i < N; i++) {
printf("Ingrese el dato [%d]: ", i);
scanf("%d", &vector[i]);
}
do {
printf("
Que posicion desea consultar (0 a %d)? ", N - 1);
scanf("%d", &pos);
if (pos >= 0 && pos < N) {
printf("El dato en la posicion %d es: %d
", pos, vector[pos]);
} else {
printf("Posicion invalida.
");
}
printf("Desea consultar otro dato? (s/n): ");
scanf(" %c", &continuar);
} while (continuar == 's' || continuar == 'S');
printf("
Programa finalizado.
");
return 0;
}
