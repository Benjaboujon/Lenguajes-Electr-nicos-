4- Realice un código que permita comparar los valores de 2 vectores, indicar cuál valor es el mayor y a qué vector corresponde.
Una vez realizado, haga que la comparación se realice a través de una función aparte del main.
#include <stdio.h>
#define N 5
void comparar(int a[], int b[], int n) {
int i;
for (i = 0; i < n; i++) {
if (a[i] > b[i]) {
printf("Posicion %d: el mayor es %d (Vector A)
", i, a[i]);
} else if (b[i] > a[i]) {
printf("Posicion %d: el mayor es %d (Vector B)
", i, b[i]);
} else {
printf("Posicion %d: ambos valores son iguales (%d)
", i, a[i]);
}
}
}
int main() {
int a[N], b[N];
int i;
printf("Datos del Vector A:
");
for (i = 0; i < N; i++) {
printf("A[%d]: ", i);
scanf("%d", &a[i]);
}
printf("
Datos del Vector B:
");
for (i = 0; i < N; i++) {
printf("B[%d]: ", i);
scanf("%d", &b[i]);
}
printf("
Comparacion:
");
comparar(a, b, N);
return 0;
}
