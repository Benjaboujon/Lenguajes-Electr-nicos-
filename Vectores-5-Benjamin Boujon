
5- Realizar un programa que ordene de mayor a menor los valores adentro de un vector de tamaño 10. A través de una función que sume esos valores y realice el promedio.
#include <stdio.h>
#define N 10
void sumaYPromedio(int v[], int n) {
int i, suma = 0;
for (i = 0; i < n; i++) {
suma += v[i];
}
printf("
Suma de los valores: %d
", suma);
printf("Promedio: %.2f
", (float)suma / n);
}
int main() {
int v[N];
int i, j, aux;
for (i = 0; i < N; i++) {
printf("Ingrese el dato [%d]: ", i);
scanf("%d", &v[i]);
}
/* Ordenamiento burbuja de mayor a menor /
for (i = 0; i < N - 1; i++) {
for (j = 0; j < N - 1 - i; j++) {
if (v[j] < v[j + 1]) {
aux = v[j];
v[j] = v[j + 1];
v[j + 1] = aux;
}
}
}
printf("
Vector ordenado de mayor a menor:
");
for (i = 0; i < N; i++) {
printf("%d ", v[i]);
}
printf("
");
sumaYPromedio(v, N);
return 0;
}
